<?xml version="1.0" encoding="utf-8"?>

<!--
    item_chat.xml
    Chat list row item. Colors are resolved from @color/ resources which
    automatically switch between res/values/colors.xml (light) and
    res/values-night/colors.xml (dark) based on the system theme.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorCardBackground"
    app:strokeColor="@color/colorCardBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <!-- FrameLayout wraps the profile image so we can overlay
             the online status dot and unread badge on top of it -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp">

            <!-- Profile picture with circular tinted background -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar_circle"
                android:src="@android:drawable/sym_def_app_icon"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:contentDescription="Profile picture"
                app:tint="@color/colorAvatarIcon" />

            <!-- Online status indicator — small green circle shown at the
                 bottom-right corner when the user is currently online -->
            <View
                android:id="@+id/onlineDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />

            <!-- Unread message count badge — red circle with white text shown
                 at the top-right corner when there are unread messages.
                 Hidden when unreadCount is 0. -->
            <TextView
                android:id="@+id/unreadBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_unread_badge"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:includeFontPadding="false" />

        </FrameLayout>

        <!-- Name + last message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/chatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/lastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last message preview"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/chatTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30"
            android:textSize="11sp"
            android:textColor="@color/colorTimestamp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>