<?xml version="1.0" encoding="utf-8"?>

<!--
    item_message_sent.xml
    Layout for a message sent by the current user.
    Bubble sits on the RIGHT side; the bottom-right corner has a 4 dp radius
    acting as the "tail". No profile picture needed since it's always the user.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:paddingStart="56dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- ── Bubble with tail pointing right ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_sent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/msgSentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:maxWidth="220dp"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/msgSentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="3dp"
            android:gravity="end"/>

    </LinearLayout>

</LinearLayout>
