<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@color/colorDivider" />

    <TextView
        android:id="@+id/bsGateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Gate Permissions"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary" />

    <TextView
        android:id="@+id/bsGateSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginTop="4dp" />

    <!-- Superadmin: Gate level controls -->
    <LinearLayout
        android:id="@+id/gateLevelControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gate Access Levels"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary" />

        <LinearLayout
            android:id="@+id/visibilityLevelRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Visibility Level:"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary" />

            <Spinner
                android:id="@+id/spinnerVisibilityLevel"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:entries="@array/gate_level_options" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/controlLevelRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Control Level:"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary" />

            <Spinner
                android:id="@+id/spinnerControlLevel"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:entries="@array/gate_level_options" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/disableControlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disable Gate:"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDisableGate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveLevels"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Save"
            android:textSize="13sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/colorDivider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Users with Access"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddUser"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:text="Add User"
        android:textSize="15sp"
        android:textColor="@color/colorFabIcon"
        app:backgroundTint="@color/colorFab"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconGravity="textStart" />

</LinearLayout>
