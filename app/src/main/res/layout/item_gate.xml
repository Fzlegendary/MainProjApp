<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/black"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/colorGateCardBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Gate Number and Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Gate Number -->
            <TextView
                android:id="@+id/tvGateNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gate 1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvGateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closed"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:background="@drawable/status_badge_closed"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

        <!-- Action Status (Opening... / Closing...) -->
        <TextView
            android:id="@+id/tvActionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ready"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:textStyle="italic" />

        <!-- Permission Badge + Admin Gear Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPermissionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/colorTextOnPrimary"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@color/colorWarning"
                android:visibility="gone"
                tools:text="Admin Only" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnGateAdminSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Gate settings"
                android:visibility="gone"
                android:scaleType="center"
                android:padding="4dp"
                app:tint="@color/colorTextSecondary" />

        </LinearLayout>

        <!-- Control Button -->
        <Button
            android:id="@+id/btnToggleGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OPEN GATE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/colorAddFab"
            android:padding="10dp"
            app:cornerRadius="14dp"
            android:textColor="@android:color/white" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>