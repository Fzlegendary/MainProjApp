<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/colorCardBackground"/>
    <!--
        All corners fully rounded except bottom-left which has a tiny radius.
        That tiny corner is the "tail" pointing toward the profile picture
        that sits to the left of this bubble.
    -->
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomRightRadius="16dp"
        android:bottomLeftRadius="4dp"/>
</shape>
